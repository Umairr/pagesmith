# Required: used by every builder and, through LiteLLM, by the lead.
OPENAI_API_KEY=sk-...

# Optional overrides (defaults shown).
# PAGESMITH_ORCHESTRATOR_MODEL=openai/gpt-5.4-mini   # any LiteLLM id, or gemini-... with GOOGLE_API_KEY
# PAGESMITH_BUILDER_MODEL=gpt-5.4-mini
# PAGESMITH_TARGET_SCORE=95
# PAGESMITH_MAX_ROUNDS=3
# PAGESMITH_BUILDER_TIMEOUT_S=420
# PAGESMITH_RUNS_DIR=./runs

# Set this on any public deployment: starting a run from the dashboard then requires it.
# PAGESMITH_ACCESS_TOKEN=
