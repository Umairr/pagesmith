# Add a key for at least one provider. With no model set below, the first
# provider that has a key is used (OpenAI, then Anthropic, Gemini, OpenRouter).
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=            # GOOGLE_API_KEY works too
# OPENROUTER_API_KEY=

# Any other OpenAI-compatible endpoint (Ollama, Groq, DeepSeek, a vLLM box, ...).
# Use it with PAGESMITH_MODEL=custom/<model-name>.
# PAGESMITH_BASE_URL=http://localhost:11434/v1
# PAGESMITH_API_KEY=

# Models are "provider/model". PAGESMITH_MODEL sets both the lead and the builders;
# the two variables after it override one side.
# PAGESMITH_MODEL=anthropic/claude-sonnet-5-5
# PAGESMITH_ORCHESTRATOR_MODEL=openai/gpt-5.4-mini
# PAGESMITH_BUILDER_MODEL=gemini/gemini-3.7-flash

# Optional overrides (defaults shown).
# PAGESMITH_TARGET_SCORE=95
# PAGESMITH_MAX_ROUNDS=3
# PAGESMITH_BUILDER_TIMEOUT_S=420
# PAGESMITH_MAX_TOKENS=16000     # reply cap for non-OpenAI providers
# PAGESMITH_RUNS_DIR=./runs

# Set this on any public deployment: starting a run from the dashboard then requires it.
# PAGESMITH_ACCESS_TOKEN=
